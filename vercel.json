{
  "version": 2,
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "https://narrai-2.onrender.com/api/$1"
    },
    {
      "src": "/static/(.*)",
      "dest": "/frontend/$1"
    },
    {
      "src": "/assets/(.*)",
      "dest": "/frontend/assets/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/frontend/$1"
    }
  ]
}
