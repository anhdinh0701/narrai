# === NarrAI Backend Environment Variables ===
# Copy this file to .env and fill in the values.

# JWT Secret — MUST be a strong random string in production
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=replace-with-a-strong-random-secret

# Database — leave empty for SQLite (local dev), set for PostgreSQL (production)
# Example: postgresql://user:password@host:5432/dbname
DATABASE_URL=

# Frontend URL — for CORS and OAuth redirects
FRONTEND_URL=http://localhost:8000

# Groq API Keys
GROQ_API_KEY=
GROQ_API_KEY_BIBLE=
GROQ_API_KEY_COPILOT=

# Google OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Facebook OAuth (optional)
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# X (Twitter) OAuth (optional)
X_CLIENT_ID=
X_CLIENT_SECRET=

# ComfyUI (optional, for local image generation)
COMFYUI_URL=

# Stability AI Post-Processing (optional)
STABILITY_API_KEY=
STABILITY_ENABLED=false
STABILITY_DEFAULT_MODE=upscale
STABILITY_IMAGE_TO_IMAGE_ENDPOINT=https://api.stability.ai/v2beta/stable-image/generate/sd3
STABILITY_UPSCALE_ENDPOINT=https://api.stability.ai/v2beta/stable-image/upscale/fast
IMAGE_POST_PROCESSOR=comfy
